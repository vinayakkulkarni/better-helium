{
  "name": "better-helium-site",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing site for better-helium — DRM playback for the Helium browser",
  "homepage": "https://better-helium.vinayakkulkarni.dev/",
  "bugs": {
    "url": "https://github.com/vinayakkulkarni/better-helium/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "url": "https://vinayakkulkarni.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinayakkulkarni/better-helium.git",
    "directory": "site"
  },
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt build && wrangler dev --config .output/server/wrangler.json",
    "deploy": "nuxt build && wrangler deploy --config .output/server/wrangler.json",
    "postinstall": "nuxt prepare",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "nuxt typecheck",
    "test": "vp test run"
  },
  "dependencies": {
    "@nuxt/scripts": "^1.3.12",
    "@nuxtjs/color-mode": "^4.0.1",
    "@openpanel/nuxt": "^0.4.2",
    "nuxt": "^4.6.2",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite-plus": "^1.4.0",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.152.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.x"
    }
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
